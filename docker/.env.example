# Copy this file to docker/.env before running Docker Compose.
# Use long, unique values and never commit docker/.env.

WGD_IMAGE=wgdashboard-commercial:latest
VCS_URL=https://github.com/your-account/your-repository
WGD_ADMIN_USERNAME=admin
WGD_ADMIN_PASSWORD=replace-with-a-strong-admin-password

POSTGRES_USER=wgdashboard
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Adminer web database manager. Keep the default localhost bind and use an
# SSH tunnel for remote administration. Use 0.0.0.0 only behind a firewall.
DB_ADMIN_BIND=127.0.0.1
DB_ADMIN_PORT=8080

TZ=Asia/Tehran
WGD_PORT=10086
WG_PORT=51820
WG_NETWORK=10.0.0.1
WG_SUBNET=24
WG_AUTOSTART=wg0
GLOBAL_DNS=1.1.1.1

# Set this to the public IP or hostname of the server. When empty, the
# container tries to detect it automatically during first startup.
PUBLIC_IP=
