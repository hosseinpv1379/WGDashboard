# Copy this file to docker/.env before running Docker Compose.
# Use long, unique values and never commit docker/.env.

WGD_IMAGE=wgdashboard-commercial:latest
VCS_URL=https://github.com/hosseinpv1379/WGDashboard
WGD_ADMIN_USERNAME=admin
WGD_ADMIN_PASSWORD=replace-with-a-strong-admin-password

DATABASE_TYPE=postgresql
POSTGRES_USER=wgdashboard
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Stable volume names. If this server already has WGDashboard installed, use
# `docker inspect wgdashboard --format '{{range .Mounts}}{{println .Name .Destination}}{{end}}'`
# and replace these values with the old names before the first upgrade start.
AMNEZIA_CONFIG_VOLUME=wgdashboard-commercial_amnezia_config
WIREGUARD_CONFIG_VOLUME=wgdashboard-commercial_wireguard_config
DASHBOARD_DATA_VOLUME=wgdashboard-commercial_dashboard_data
POSTGRES_DATA_VOLUME=wgdashboard-commercial_postgres_data

# Optional: lets new wg-node agents self-register. Leave empty when nodes are
# created manually from the panel. The subscription encryption key is generated
# automatically in the persistent dashboard volume when left empty.
WGD_NODE_BOOTSTRAP_TOKEN=
WGD_SUBSCRIPTION_ENCRYPTION_KEY=

# Adminer web database manager. Keep the default localhost bind and use an
# SSH tunnel for remote administration. Use 0.0.0.0 only behind a firewall.
DB_ADMIN_BIND=127.0.0.1
DB_ADMIN_PORT=8080

TZ=Asia/Tehran
WGD_PORT=10086
WG_PORT=51820
WG_NETWORK=10.0.0.1
WG_SUBNET=24
WG_AUTOSTART=wg0
GLOBAL_DNS=1.1.1.1

# Set this to the public IP or hostname of the server. When empty, the
# container tries to detect it automatically during first startup.
PUBLIC_IP=
